-- ===== Core entities =====
CREATE TABLE Users (
  id            INTEGER PRIMARY KEY,
  first_name    TEXT    NOT NULL,
  last_name     TEXT    NOT NULL,
  phone_number  TEXT,
  email_address TEXT    NOT NULL UNIQUE,
  role          TEXT    NOT NULL CHECK (role IN ('guest','staff','admin'))
);

CREATE TABLE Tables (           -- &quot;Table&quot; is een keyword; gebruik &quot;Tables&quot;
  id             INTEGER PRIMARY KEY,
  table_number   INTEGER NOT NULL UNIQUE,
  table_capacity INTEGER NOT NULL CHECK (table_capacity &gt; 0),
  is_active      INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0,1))
);

CREATE TABLE Themes (
  id        INTEGER PRIMARY KEY,
  name      TEXT    NOT NULL,
  course    TEXT    NOT NULL,                       -- bijv. 'starter' | 'main' | 'dessert'
  is_active INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0,1))
);

CREATE TABLE Dishes (
  id          INTEGER PRIMARY KEY,
  name        TEXT    NOT NULL,
  price       REAL    NOT NULL CHECK (price &gt;= 0),
  description TEXT,
  type        TEXT    NOT NULL                      -- bijv. 'starter' | 'main' | 'dessert' | 'drink'
);

-- ===== Linking / calendars =====
CREATE TABLE Dishes_Themes (
  id       INTEGER PRIMARY KEY,
  dish_id  INTEGER NOT NULL,
  theme_id INTEGER NOT NULL,
  UNIQUE (dish_id, theme_id),
  FOREIGN KEY (dish_id)  REFERENCES Dishes(id) ON DELETE CASCADE,
  FOREIGN KEY (theme_id) REFERENCES Themes(id) ON DELETE CASCADE
);

CREATE TABLE Theme_Calendar (
  id          INTEGER PRIMARY KEY,
  theme_id    INTEGER NOT NULL,
  date        TEXT    NOT NULL,   -- ISO-8601: 'YYYY-MM-DD'
  time_slot   TEXT    NOT NULL,   -- bijv. '18:00', of 'evening'
  description TEXT,
  UNIQUE (theme_id, date, time_slot),
  FOREIGN KEY (theme_id) REFERENCES Themes(id) ON DELETE CASCADE
);

-- ===== Reservations =====
CREATE TABLE Reservations (
  id               INTEGER PRIMARY KEY,
  user_id          INTEGER NOT NULL,
  table_id         INTEGER NOT NULL,
  guest_count      INTEGER NOT NULL CHECK (guest_count &gt; 0),
  start_at         TEXT    NOT NULL,  -- ISO-8601: 'YYYY-MM-DD HH:MM'
  status           TEXT    NOT NULL DEFAULT 'pending'
                    CHECK (status IN ('pending','confirmed','seated','cancelled','no_show','completed')),
  can_modify_until TEXT,              -- ISO-8601
  created_at       TEXT    NOT NULL DEFAULT (datetime('now')),
  updated_at       TEXT    NOT NULL DEFAULT (datetime('now')),
  -- voorkom dubbele boekingen per tafel &amp; startmoment
  UNIQUE (table_id, start_at),
  FOREIGN KEY (user_id) REFERENCES Users(id)   ON DELETE CASCADE,
  FOREIGN KEY (table_id) REFERENCES Tables(id) ON DELETE CASCADE
);

CREATE TABLE Reservations_Dishes (
  id              INTEGER PRIMARY KEY,
  reservation_id  INTEGER NOT NULL,
  dish_id         INTEGER NOT NULL,
  UNIQUE (reservation_id, dish_id),
  FOREIGN KEY (reservation_id) REFERENCES Reservations(id) ON DELETE CASCADE,
  FOREIGN KEY (dish_id)        REFERENCES Dishes(id)       ON DELETE CASCADE
);

-- ===== Indexes (FK performance) =====
CREATE INDEX idx_reservations_user   ON Reservations(user_id);
CREATE INDEX idx_reservations_table  ON Reservations(table_id);
CREATE INDEX idx_resdish_reservation ON Reservations_Dishes(reservation_id);
CREATE INDEX idx_resdish_dish        ON Reservations_Dishes(dish_id);
CREATE INDEX idx_dish_theme_dish     ON Dishes_Themes(dish_id);
CREATE INDEX idx_dish_theme_theme    ON Dishes_Themes(theme_id);
CREATE INDEX idx_theme_cal_theme     ON Theme_Calendar(theme_id);

-- ===== Trigger: updated_at automatisch bijwerken =====
CREATE TRIGGER trg_reservations_updated_at
AFTER UPDATE ON Reservations
FOR EACH ROW
BEGIN
  UPDATE Reservations
  SET updated_at = datetime('now')
  WHERE id = NEW.id;
END;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
